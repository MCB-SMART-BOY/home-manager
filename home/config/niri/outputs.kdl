// 显示器输出配置
// 由 config.kdl 通过 include "outputs.kdl" 引入。
//
// 本文件包含机器特定的显示器连接器、分辨率、刷新率和位置。
// 多机器部署时，替换本文件即可适配不同显示器布局。
//
// niri 26.04 支持 optional include —— 文件不存在时仅记录警告，
// niri 自动探测显示器配置。参见 https://niri-wm.github.io/niri/Configuration%3A-Include.html
// ══════════════════════════════════════════════════════════════════
// 🖥️ 输出配置
// ══════════════════════════════════════════════════════════════════
//
// 首次部署到新机器时，建议先注释所有 output 块，让 niri 自动探测。
// 登录后运行：
//
//   niri msg outputs
//
// 获取输出名称、模式、缩放与描述信息，再恢复对应配置。
//
// niri 26.04 更推荐使用显示器的稳定描述名称，而不是可能随显卡和接口变化的
// eDP-1 / DP-1 连接器名称。由于这里没有保存显示器描述，暂时保留原连接器配置。

output "eDP-1" {
    // 内置屏：3200×2000，165 Hz；scale=2 后逻辑分辨率约为 1600×1000。
    mode "3200x2000@165.002"
    scale 2

    // 内屏位于全局坐标右侧。
    position x=0 y=0
}

// 备用连接器配置。不同显卡模式下，外屏可能显示为 DP-5。
// output "DP-5" {
//     mode "3840x2160@160.000"
//     scale 2
//     position x=-1920 y=-80
// }

output "DP-1" {
    // 外屏：3840×2160，160 Hz；scale=2 后逻辑分辨率约为 1920×1080。
    mode "3840x2160@160.000"
    scale 2

    // 外屏放在内屏左侧，并通过 y=-80 调整垂直视觉对齐。
    position x=-1920 y=-80
}
