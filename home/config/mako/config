# Mako 通知配置
# ~/.config/mako/config
# Catppuccin Mocha 主题（Garuda Mokka 移植）

# 基础样式
font=Noto Sans CJK SC 11
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#cba6f7
border-size=2
border-radius=18
progress-color=over #cba6f7

# 尺寸与位置
width=380
height=150
margin=22
padding=16
anchor=top-right

# 行为
# 通知格式：标题 + 正文（Pango）
format=<b>%s</b>\n<span foreground="#a6adc8">%b</span>
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
sort=-time # 最新通知优先显示
max-history=20 # 历史记录上限
group-by=app-name # 按应用聚合，减少刷屏

# 图标
icons=1
max-icon-size=48
icon-path=~/.nix-profile/share/icons/Papirus-Dark:~/.local/share/icons/Papirus-Dark

# 勿扰模式
[mode=do-not-disturb]
invisible=1

[urgency=low]
background-color=#1e1e2ee6
border-color=#a6e3a1

[urgency=normal]
background-color=#1e1e2ee6
border-color=#cba6f7

[urgency=high]
background-color=#1e1e2ee6
border-color=#f38ba8
default-timeout=0
