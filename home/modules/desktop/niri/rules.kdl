// 窗口规则配置
// 由 config.kdl 通过 include "rules.kdl" 引入。
//
// 所有应用级别的窗口行为（浮动、圆角、尺寸约束）统一管理。
// 新增应用的窗口规则只应修改本文件。
// 快捷键通过 binds.kdl 中的 spawn/class 匹配本文件的 app-id 规则。
// ══════════════════════════════════════════════════════════════════
// 🪟 窗口规则
// ══════════════════════════════════════════════════════════════════

window-rule {
    // 所有常规窗口统一圆角，并裁剪客户端内容，避免方形内容溢出。
    geometry-corner-radius 18
    clip-to-geometry true

    // 透明窗口只显示细焦点环，避免 niri 在窗口背后绘制整块焦点色矩形；
    // 否则 Kitty 的半透明区域会被当前窗口的紫色焦点色整片染色。
    draw-border-with-background false
}

window-rule {
    // Kitty 与浮动终端：niri 26.04 负责背景模糊，Kitty 负责半透明背景；
    // 文字仍由 Kitty 以不透明方式绘制，不随窗口背景一起变淡。
    match app-id=r#"^(kitty|float-term)$"#

    background-effect {
        blur true
        noise 0.0
        saturation 1.0
    }
}

window-rule {
    // 工具型窗口默认浮动，不占据滚动平铺带。
    match app-id=r#"^(pavucontrol|org\.keepassxc\.KeePassXC)$"#
    open-floating true
}

window-rule {
    // 同时兼容原生 Firefox 与 Flatpak Firefox 的 app-id 结尾。
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// 浮动终端（Mod+Alt+Return）：用于临时命令、快速查询，不改变当前平铺结构。
window-rule {
    match app-id="float-term"
    open-floating true
    default-column-width { proportion 0.4; }
}

// OBS：默认浮动，避免录制控制窗口把工作区主布局挤乱。
window-rule {
    match app-id="obs"
    open-floating true
    default-column-width { proportion 0.6; }
}

// Noctalia v5 Settings：固定合理尺寸并浮动显示。
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}
